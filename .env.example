# Used by the root docker-compose.yml (full stack in Docker).
# Copy to .env and replace the placeholder password. Never commit .env.

POSTGRES_USER=edu_app
# Use letters and digits only: the password is embedded in a connection URL.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=edu_payments

# Host ports for the admin UI and the API.
WEB_PORT=3000
API_PORT=4000
