# Copy to .env and replace the placeholder values. Never commit .env.

# --- Local PostgreSQL container (used by docker-compose.yml) ---
POSTGRES_USER=edu_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=edu_payments
POSTGRES_PORT=5433

# --- API ---
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed by CORS (the admin UI).
CORS_ORIGIN=http://localhost:3000

# Main database. Must match the POSTGRES_* values above when using docker compose.
DATABASE_URL=postgresql://edu_app:change_me@localhost:5433/edu_payments?schema=public

# Separate database used by the integration tests. It is migrated and wiped by `npm test`,
# so it must NEVER point at a database you care about.
TEST_DATABASE_URL=postgresql://edu_app:change_me@localhost:5433/edu_payments_test?schema=public
